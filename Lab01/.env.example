# Token: https://github.com/settings/tokens -> classic, sem marcar nenhum scope.

GITHUB_TOKEN=ghp_seu_token_aqui
GITHUB_API_URL=https://api.github.com/graphql
GITHUB_USER_AGENT=lab01-eng-sw-pucminas

SEARCH_QUERY=stars:>10000 sort:stars-desc

# Testado: 25 e 20 falham por timeout do servidor do GitHub, por causa dos
# campos aninhados da query. 10 conclui. Nao aumente sem testar.
PAGE_SIZE=10

# 100 na Sprint 1, 1000 na Sprint 2. O search do GitHub nao devolve mais que 1000.
TARGET_REPOS=1000

# ---- Snapshot do board (src/snapshots) -------------------------------------
# Este script exige um token com o escopo read:project marcado.
# O token da coleta, sem scopes, nao serve aqui.
# PROJECT_NUMBER e o numero que aparece na URL do board:
#   https://github.com/users/<owner>/projects/<numero>
PROJECT_OWNER=Victorgabrielcruz
PROJECT_NUMBER=1
SPRINT=Lab01S01
